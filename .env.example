# Copy this file to ".env" in the same folder and fill in your values.
# This file stays on your machine. Never paste these values into a chat.

# From Developer Central after you create your private app
LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxxxxxx
LWA_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxxxxxxxxxxxxxx

# From clicking "Authorize app" on your own app (self-authorization)
LWA_REFRESH_TOKEN=Atzr|xxxxxxxxxxxxxxxxxxxx

# na = North America | eu = Europe, UK, India, Middle East | fe = Japan, Australia, Singapore
SPAPI_REGION=eu

# Country code (US, IN, UK, DE, AE...) or a raw marketplace id.
# Comma-separate for several marketplaces in the same region.
SPAPI_MARKETPLACE_ID=IN

# Where the downloaded reports land. Connect this same folder in the Claude
# desktop app so Claude can read the full files.
OUTPUT_DIR=C:\Users\YourName\AmazonReports
